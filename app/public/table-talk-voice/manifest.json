  "mabel|You're near the end peg. Every peg counts now.": "table-talk-voice/mabel-5dee6f1654f4a33ed88e.webm",
  "mabel|Near the end. Let's see what happens.": "table-talk-voice/mabel-b9f04d3f351dd3381fc5.webm",
  "mabel|You are getting a bit close for comfort.": "table-talk-voice/mabel-3dc26c264cb8494809fb.webm",
  "mabel|I see that peg nearing home.": "table-talk-voice/mabel-eb32dd9c1552bba1be03.webm",
