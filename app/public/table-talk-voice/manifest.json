  "arthur|Cards ready. Dignity may be optional.": "table-talk-voice/arthur-e4a1610a277bf5d22af5.webm",
  "arthur|Excellent, a fresh chance to misread everything.": "table-talk-voice/arthur-a47e008da139e04e7c4a.webm",
  "arthur|All right, let us see how this goes.": "table-talk-voice/arthur-febc0ad3ce27e7de5a33.webm",
  "arthur|Another game, I'm in.": "table-talk-voice/arthur-7f840b1de28230f40b9b.webm",
