  "mabel|That gap opened up on me.": "table-talk-voice/mabel-8217a2d7aeecda4d18ab.webm",
  "mabel|Behind for now, but not out.": "table-talk-voice/mabel-a049c8a0a455586b7e37.webm",
  "mabel|I have some ground to make up.": "table-talk-voice/mabel-c1a5ac50de23b0a4e568.webm",
  "mabel|The pegs are asking me to catch up.": "table-talk-voice/mabel-2f7e0ce09557e04b1004.webm",
