  "mabel|Your peg has the better view now.": "table-talk-voice/mabel-69feb1190e1cf80080fa.webm",
  "mabel|I'm close, but I'm not celebrating yet.": "table-talk-voice/mabel-91dd5d6be83a3ce077ef.webm",
  "mabel|Getting near the finish peg now.": "table-talk-voice/mabel-ecec21c8f82f9eefff1b.webm",
  "mabel|Almost home, if luck behaves.": "table-talk-voice/mabel-ab7b0406a32537ed3326.webm",
  "mabel|Just a little farther to go.": "table-talk-voice/mabel-25b2fdad3e31bb6b0a7c.webm",
