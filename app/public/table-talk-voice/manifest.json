  "mabel|That's a healthy crib.": "table-talk-voice/mabel-ec1ab622a309881441cf.webm",
  "mabel|Big crib there; how does it feel?": "table-talk-voice/mabel-dbb2296e9411cbb2a8ea.webm",
  "mabel|Nice crib, maybe it will become a trend.": "table-talk-voice/mabel-2eaece8548f80328f727.webm",
  "mabel|Great crib.": "table-talk-voice/mabel-01221fe6b59be1d2e7fd.webm",
  "mabel|Nothing like a surprise crib, would you agree?": "table-talk-voice/mabel-95d7ec0741b6929cbebf.webm",
  "mabel|Looks like I've slipped into the lead.": "table-talk-voice/mabel-a7cf1ea385acd6fd1db3.webm",
  "mabel|Lead change in my favor.": "table-talk-voice/mabel-a93e0540d89c8a4dfff9.webm",
