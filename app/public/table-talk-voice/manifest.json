  "mabel|A nice finish to a good game.": "table-talk-voice/mabel-91c8c69ac9c859480541.webm",
  "mabel|Well played. You earned that one.": "table-talk-voice/mabel-bcc387938fc0ddf70a20.webm",
  "mabel|Good game, truly. I'll get you next hand.": "table-talk-voice/mabel-fd49ffcfe4ac50329aab.webm",
  "mabel|You got me this time; nicely done.": "table-talk-voice/mabel-69abcc18dbb286bf0f39.webm",
  "mabel|That was well played from start to finish.": "table-talk-voice/mabel-8f4cb7f457e54df6b511.webm",
